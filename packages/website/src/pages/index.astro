---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/react/header';
import Hero from '../components/react/Hero';
import GettingStarted from '../components/GettingStarted.astro';
import FeaturesGrid from '../components/react/FeaturesGrid';
import HowItWorksSection from '../components/react/HowItWorksSection';
import CustomSetupSection from '../components/react/CustomSetupSection';
import FAQ from '../components/FAQ.astro';
import Footer from '../components/react/footer';
import { AD_BANNER } from '../data/topbar-zone-config';
---

<BaseLayout>
  <Header client:load showBanner adBanner={AD_BANNER} />
  <main>
    <Hero />
    <GettingStarted />
    <FeaturesGrid />
    <HowItWorksSection client:visible />
    <CustomSetupSection />
    <FAQ />
  </main>
  <Footer client:visible />
</BaseLayout>
