---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Header from '../components/react/header';
import GettingStarted from '../components/GettingStarted.astro';
import Features from '../components/Features.astro';
import HowItWorks from '../components/HowItWorks.astro';
import CustomSetup from '../components/CustomSetup.astro';
import FAQ from '../components/FAQ.astro';
import Footer from '../components/react/footer';
import { AD_BANNER } from '../data/topbar-zone-config';
---

<BaseLayout>
  <Header client:load showBanner adBanner={AD_BANNER} />
  <main>
    <Hero />
    <GettingStarted />
    <Features />
    <HowItWorks />
    <CustomSetup />
    <FAQ />
  </main>
  <Footer client:visible />
</BaseLayout>
